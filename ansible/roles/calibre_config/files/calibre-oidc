#!/usr/bin/env python3
# Sets Calibre-Web's generic OIDC login in app.db. stdin: JSON {db, issuer, secret}.
# Prints "changed" when it wrote anything (the container then needs a restart).
import json
import sqlite3
import sys

s = json.load(sys.stdin)
i = s["issuer"] + "/api/oidc/"
provider = {  # row 3 is the "generic" provider
    "oauth_client_id": "calibre-web", "oauth_client_secret": s["secret"],
    "metadata_url": s["issuer"] + "/.well-known/openid-configuration",
    "oauth_authorize_url": i + "authorization", "oauth_token_url": i + "token", "oauth_userinfo_url": i + "userinfo",
    "scope": "openid profile email groups", "username_mapper": "preferred_username", "email_mapper": "email",
    "oauth_admin_group": "admins", "login_button": "Authelia", "active": 1,
}
# 2 = OAuth. No redirect host: with one, every redirect (even "/") goes to the public URL and the image's
# healthcheck fails; the callback is built from Traefik's forwarded headers anyway.
settings = {"config_login_type": 2, "config_oauth_redirect_host": "",
            "config_enable_oauth_group_admin_management": 1}

db = sqlite3.connect(s["db"])
changed = False
for table, where, want in (("oauthProvider", "id = 3", provider), ("settings", "1 = 1", settings)):
    cols = list(want)
    have = db.execute(f"SELECT {', '.join(cols)} FROM {table} WHERE {where}").fetchone()
    if have is None:
        sys.exit(f"{table}: no row ({where}); has Calibre-Web started once?")
    if list(have) != list(want.values()):
        db.execute(f"UPDATE {table} SET {', '.join(c + ' = ?' for c in cols)} WHERE {where}", list(want.values()))
        changed = True
db.commit()
print("changed" if changed else "ok")
