#!/usr/bin/env python3
# Managed by Ansible (core_stacks). Creates Authelia's OIDC secrets in the directory given as argument 1,
# once: an HMAC secret, an RSA signing key and, per client named after it, a random client secret
# (<name>.secret, read by the client's own setup) and its pbkdf2-sha512 digest (<name>.digest, read by
# Authelia). Existing files are never touched. Prints "created" when it made anything.
import base64
import hashlib
import os
import secrets
import subprocess
import sys


def ab64(raw):
    # passlib's "adapted base64", the format Authelia reads: no padding, "." instead of "+"
    return base64.b64encode(raw).decode().rstrip("=").replace("+", ".")


def digest(password, rounds=310000):
    salt = secrets.token_bytes(16)
    key = hashlib.pbkdf2_hmac("sha512", password.encode(), salt, rounds)
    return f"$pbkdf2-sha512${rounds}${ab64(salt)}${ab64(key)}"


def write(path, content):
    with open(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
        f.write(content)


directory, clients = sys.argv[1], sys.argv[2:]
os.makedirs(directory, mode=0o700, exist_ok=True)
os.chdir(directory)
created = False
if not os.path.exists("hmac"):
    write("hmac", secrets.token_hex(64))
    created = True
if not os.path.exists("jwks.pem"):
    subprocess.run(["openssl", "genpkey", "-algorithm", "RSA", "-pkeyopt", "rsa_keygen_bits:2048",
                    "-out", "jwks.pem"], check=True, capture_output=True)
    os.chmod("jwks.pem", 0o600)
    created = True
for name in clients:
    if not os.path.exists(f"{name}.secret"):
        secret = secrets.token_urlsafe(48)
        write(f"{name}.digest", digest(secret))
        write(f"{name}.secret", secret)
        created = True
if created:
    print("created")
