#!/usr/bin/env python3
# Managed by Ansible (core_stacks). Password on stdin (never in argv, so never in `ps`).
# Prints the current hash (argument 1) if the password still matches it, else a new hash.
# argon2id with Authelia's default parameters (m=65536, t=3, p=4).
import sys

import argon2
from argon2.exceptions import VerificationError

# Debian 13 ships argon2-cffi 21.1, where the newer InvalidHashError is still called InvalidHash.
InvalidHash = getattr(argon2.exceptions, "InvalidHashError", argon2.exceptions.InvalidHash)

password = sys.stdin.read().rstrip("\n")
hasher = argon2.PasswordHasher(time_cost=3, memory_cost=65536, parallelism=4)
current = sys.argv[1] if len(sys.argv) > 1 else ""
try:
    if current and hasher.verify(current, password):
        print(current)
        sys.exit(0)
except (VerificationError, InvalidHash):
    pass
print(hasher.hash(password))
